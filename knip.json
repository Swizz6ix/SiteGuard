{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "project": [
        "**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "!fixtures/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/coverage/**"
      ],
      "ignore": [
        "eslint.config.mjs"
      ]
    },
    "apps/cli": {
      "project": [
        "src/**/*.{ts,tsx,js,jsx}",
        "test/**/*.{ts,tsx}"
      ]
    },
    "packages/*": {
      "project": [
        "src/**/*.{ts,tsx,js,jsx}",
        "test/**/*.{ts,tsx}"
      ]
    }
  }
}