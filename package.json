{
  "name": "siteguard",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade codebase and website quality gate.",
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "siteguard": "pnpm --filter @siteguard/cli exec siteguard",
    "health": "pnpm siteguard health",
    "version:check": "pnpm siteguard version",
    "ci": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm build",
    "dead-code": "knip",
    "dependency-audit": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "knip": "^5.64.0"
  }
}
